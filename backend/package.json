{
  "name": "driftix-backend",
  "version": "1.0.0",
  "description": "Backend for Driftix SaaS platform",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:monitor\" \"npm run dev:redis\"",
    "dev:monitor": "ts-node src/utils/cleanupMonitor.ts",
    "dev:redis": "redis-server",
    "health": "ts-node src/utils/healthCheck.ts",
    "maintenance": "ts-node scripts/maintenance.ts",
    "maintenance:watch": "nodemon --watch src --ext ts --exec \"npm run maintenance\"",
    "cleanup": "ts-node scripts/cleanup.ts",
    "cleanup:monitor": "ts-node scripts/run-cleanup.ts",
    "cleanup:watch": "CLEANUP_INTERVAL=180000 nodemon --watch src --ext ts,tsx --exec npm run cleanup:monitor",
    "cleanup:ci": "CLEANUP_INTERVAL=900000 nodemon --watch src --ext ts,tsx --exec npm run cleanup:monitor",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "keywords": [
    "api",
    "nodejs",
    "typescript",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/swagger": "^11.1.3",
    "@sentry/node": "^7.107.0",
    "@sentry/tracing": "^7.107.0",
    "@slack/web-api": "^7.0.1",
    "@types/winston": "^2.4.4",
    "bcryptjs": "^2.4.3",
    "chokidar": "^3.5.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "redis": "^4.6.11",
    "socket.io": "^4.7.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.17",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mongodb-memory-server": "^2.3.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.19",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "bullmq": "^5.48.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.1.9",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
