{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": "api"
      }
    ]
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs20",
    "ignore": [
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "**/node_modules/**",
      "src/**",
      "coverage/**",
      "tests/**",
      "scripts/**",
      ".husky/**",
      ".github/**"
    ],
    "predeploy": [
      "npm run build"
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001,
      "host": "localhost"
    },
    "hosting": {
      "port": 8000,
      "host": "localhost"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "localhost"
    },
    "hub": {
      "port": 4400,
      "host": "localhost"
    },
    "logging": {
      "port": 4500,
      "host": "localhost"
    },
    "eventarc": {
      "port": 4600,
      "host": "localhost"
    },
    "tasks": {
      "port": 4700,
      "host": "localhost"
    }
  }
} 